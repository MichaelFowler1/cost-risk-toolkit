# Environments
.venv/
env/
venv/

# Python artifacts
__pycache__/
*.pyc

# Local Data/Results (keeps your repo clean)
# The blanket *.csv rule is deliberate: it is what stops real contractor cost
# data being committed by accident. Add exceptions one file at a time, and
# only for files that are safe to publish.
*.csv
*.json
!pyproject.toml

# Invented sample input for `ce-core fit-lots`, so a fresh clone has something
# to run against. Six made-up lots; no real programme data.
!/example_lots.csv

# Documentation for the golden regression test: tolerances and exclusions, no data.
!/tests/goldens/COMPARE_POLICY.json

# Page text from five of DoD's released Selected Acquisition Reports, the
# fixtures for tests/test_public.py. U.S. government works, public domain,
# already published by DoD; nothing here is contractor data.
!/tests/fixtures/sar/*.json

# Editor run configurations. Portable -- every path is relative to the
# workspace -- so they travel with the repo rather than being rebuilt by hand.
!/.vscode/launch.json

# OS junk
.DS_Store
# Build artifacts (pip install . / python -m build)
build/
dist/

# Run output. Charts and the assumptions log are regenerated from a seed or
# from your own input file, so they do not belong in version control -- and
# output from real cost data should never be committed by accident.
results/
artifacts/
results*/

# setuptools metadata from an editable install or a build; regenerated every time
*.egg-info/

# The worked AoA spec the README points at. Invented numbers, no program data.
!/docs/aoa_example.json
!/docs/portfolio_example.json
!/docs/jcl_example.json
